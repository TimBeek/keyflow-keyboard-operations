DATABASE_URL=postgres://keyflow:change-me@localhost:5432/keyflow
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10
KEYFLOW_IMPORT_ACTOR_ID=00000000-0000-0000-0000-000000000001
KEYFLOW_EMPLOYEE_ACTOR_ID=00000000-0000-0000-0000-000000000002
# Optioneel: standaard is db/seed/inventory-source.json.
KEYFLOW_INVENTORY_SOURCE=db/seed/inventory-source.json
# Maximale ouderdom van de laatste geslaagde herstelproef.
KEYFLOW_RECOVERY_MAX_AGE_DAYS=90

# Laat op pilot staan totdat database, Entra-appregistratie en app-rollen gereed zijn.
KEYFLOW_AUTH_MODE=pilot
KEYFLOW_BASE_URL=https://keyflow.example.nl
AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
AUTH_TRUST_HOST=true
AUTH_MICROSOFT_ENTRA_ID_ID=00000000-0000-0000-0000-000000000000
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-with-the-client-secret-value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
